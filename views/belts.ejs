<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Belts Totem - Code Ninjas</title>
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/icons/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/responsive.css">
  
  <% if (theme === 'space') { %>
    <link href="https://fonts.googleapis.com/css2?family=Luckiest+Guy&family=Fredoka:wght@400;600;700&display=swap" rel="stylesheet">
  <% } else if (theme === 'cyber') { %>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Exo+2:wght@300;600;800&display=swap" rel="stylesheet">
  <% } else if (theme === 'deepsea') { %>
    <link href="https://fonts.googleapis.com/css2?family=Titan+One&family=Nunito:wght@400;700;900&display=swap" rel="stylesheet">
  <% } else if (theme === 'undertale') { %>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <% } %>

  <style>
    :root {
      --cn-blue: #358ebc;
      --cn-dark: #231f20;
      --cn-gray: #f5f6f8;
    }
    body { background-color: var(--cn-gray); font-family: 'Segoe UI', sans-serif; }
    .sidebar { width: 240px; background: var(--cn-dark); min-height: 100vh; color: white; position: fixed; }
    .main { padding: 40px; }
    .with-sidebar { margin-left: 240px; }
    .no-sidebar { max-width: 100%; margin: 0 auto; }
    
    .nav-link { color: #99aabb; padding: 12px 20px; border-radius: 8px; margin: 4px 10px; }
    .nav-link:hover, .nav-link.active { background: rgba(255,255,255,0.1); color: white; }
    .nav-link.active { background: var(--cn-blue); }
    
    .btn-back { border-radius: 20px; font-weight: 600; padding: 8px 20px; }
    
    .totem-grid {
      display: flex;
      overflow-x: auto;
      gap: 20px;
      padding: 20px 0;
      align-items: flex-start;
      min-height: 80vh;
    }
    
    .belt-column {
      min-width: 280px;
      flex: 0 0 auto;
      display: flex;
      flex-direction: column;
    }
    
    .belt-header {
      padding: 20px;
      border-radius: 15px;
      color: white;
      text-align: center;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 2px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.15);
      margin-bottom: 25px;
      text-shadow: 1px 1px 3px rgba(0,0,0,0.3);
      position: sticky;
      top: 0;
      z-index: 10;
    }
    
    .ninja-card {
      background: white;
      border-radius: 18px;
      padding: 20px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
      margin-bottom: 20px;
      border-top: 6px solid #ddd;
    }
    
    .ninja-list { list-style: none; padding: 0; margin: 0; }
    .ninja-item {
      padding: 10px 12px;
      font-size: 1.05rem;
      color: #334455;
      font-weight: 700;
      transition: all 0.2s ease-in-out;
      border-radius: 8px;
    }
    .ninja-item:hover {
      background-color: rgba(53, 142, 188, 0.1);
      transform: translateX(5px);
      color: var(--cn-blue);
    }
    
    /* Belt Colors */
    .belt-white { background: #f8f9fa; color: #333 !important; border: 1px solid #ddd; text-shadow: none !important; }
    .belt-yellow { background: #fff200; color: #333 !important; text-shadow: none !important; }
    .belt-orange { background: #f7941d; }
    .belt-green { background: #00a651; }
    .belt-blue { background: #00aeef; }
    .belt-purple { background: #662d91; }
    .belt-brown { background: #754c24; }
    .belt-red { background: #ed1c24; }
    .belt-black { background: #231f20; }
    .belt-bronze { background: #cd7f32; }
    .belt-silver { background: #c0c0c0; color: #333 !important; text-shadow: none !important; }
    .belt-platinum { background: #e5e4e2; color: #333 !important; text-shadow: none !important; }
    .belt-gold { background: linear-gradient(45deg, #ffd700, #ffaa00); }
    .belt-going-gold { background: linear-gradient(45deg, #ffd700, #ffaa00); }
    
    .border-white { border-top-color: #eee !important; }
    .border-yellow { border-top-color: #fff200 !important; }
    .border-orange { border-top-color: #f7941d !important; }
    .border-green { border-top-color: #00a651 !important; }
    .border-blue { border-top-color: #00aeef !important; }
    .border-purple { border-top-color: #662d91 !important; }
    .border-brown { border-top-color: #754c24 !important; }
    .border-red { border-top-color: #ed1c24 !important; }
    .border-black { border-top-color: #231f20 !important; }
    .border-bronze { border-top-color: #cd7f32 !important; }
    .border-silver { border-top-color: #c0c0c0 !important; }
    .border-platinum { border-top-color: #e5e4e2 !important; }
    .border-gold { border-top-color: #ffd700 !important; }
    .border-going-gold { border-top-color: #ffaa00 !important; }

    .totem-grid::-webkit-scrollbar { height: 20px; }
    .totem-grid::-webkit-scrollbar-track { background: rgba(0,0,0,0.05); border-radius: 10px; }
    .totem-grid::-webkit-scrollbar-thumb { background: var(--cn-blue); border-radius: 10px; border: 4px solid #f5f6f8; }
    .totem-grid::-webkit-scrollbar-thumb:hover { background: var(--cn-blue-dark); }

    .scroll-container-wrapper { position: relative; }
    .scroll-btn {
      position: absolute;
      right: -20px;
      top: 50%;
      transform: translateY(-50%);
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: var(--cn-blue);
      color: white;
      border: 8px solid white;
      box-shadow: 0 10px 25px rgba(0,0,0,0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.5rem;
      z-index: 100;
      cursor: pointer;
      transition: all 0.2s;
    }
    .scroll-btn:hover { background: #231f20; transform: translateY(-50%) scale(1.1); }
    .scroll-btn:active { transform: translateY(-50%) scale(0.95); }
    
    @media (max-width: 768px) {
      .scroll-btn { display: none; }
    }
  </style>

  <% if (theme === 'space') { %>
  <style>
    :root { --cn-blue: #4D96FF; --cn-dark: #1A1A2E; --cn-gray: #1A1A2E; }
    body { background-color: #1A1A2E !important; background-image: radial-gradient(white, rgba(255,255,255,.2) 2px, transparent 40px), radial-gradient(white, rgba(255,255,255,.15) 1px, transparent 30px) !important; background-size: 550px 550px, 350px 350px !important; color: #e8eaff !important; font-family: 'Fredoka', sans-serif !important; }
    .ninja-card { background: rgba(255,255,255,0.95) !important; color: #1A1A2E !important; border-top-width: 6px !important; }
    .ninja-item { color: #1A1A2E !important; }
    h2 { font-family: 'Luckiest Guy' !important; color: #FFD93D !important; }
    .text-muted { color: #b0bae8 !important; }
    .totem-grid::-webkit-scrollbar-thumb { border-color: #1A1A2E !important; }
  </style>
  <% } else if (theme === 'cyber') { %>
  <style>
    :root { --cn-blue: #FF9F1C; --cn-dark: #011627; --cn-gray: #011627; }
    body { background-color: #011627 !important; background-image: linear-gradient(rgba(46,196,182,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(46,196,182,0.05) 1px, transparent 1px) !important; background-size: 30px 30px !important; color: #FDFFFC !important; font-family: 'Exo 2', sans-serif !important; }
    .ninja-card { background: rgba(1,22,39,0.92) !important; border: 1px solid rgba(46,196,182,0.35) !important; border-left: 4px solid #FF9F1C !important; border-radius: 8px !important; color: #FDFFFC !important; backdrop-filter: blur(10px); }
    .ninja-item { color: #FDFFFC !important; border-bottom-color: rgba(46,196,182,0.15) !important; }
    h2 { font-family: 'Orbitron' !important; color: #FFBF00 !important; }
    .text-muted { color: #8899aa !important; }
    .totem-grid::-webkit-scrollbar-thumb { border-color: #011627 !important; }
  </style>
  <% } else if (theme === 'deepsea') { %>
  <style>
    :root { --cn-blue: #00e5ff; --cn-dark: #000d1a; --cn-gray: #000d1a; }
    body { background: radial-gradient(ellipse at 20% 80%, #001f3f 0%, #000d1a 60%, #000508 100%) fixed !important; color: #94d2bd !important; font-family: 'Nunito', sans-serif !important; }
    .ninja-card { background: rgba(0,20,50,0.82) !important; border: 2px solid rgba(0,229,255,0.45) !important; border-radius: 14px !important; color: #94d2bd !important; backdrop-filter: blur(8px); }
    .ninja-item { color: #94d2bd !important; border-bottom-color: rgba(0,229,255,0.15) !important; }
    h2 { font-family: 'Titan One' !important; color: #00e5ff !important; text-shadow: 0 0 12px rgba(0,229,255,0.5); }
    .text-muted { color: #7aada8 !important; }
    .totem-grid::-webkit-scrollbar-thumb { border-color: #000d1a !important; }
  </style>
  <% } else if (theme === 'undertale') { %>
  <style>
    :root { --cn-blue: #00ffff; --cn-dark: #000; --cn-gray: #000; }
    body { background: #000 !important; color: #fff !important; font-family: 'Press Start 2P', monospace !important; font-size: 0.72rem !important; image-rendering: pixelated; }
    body::after { content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 9998; background: repeating-linear-gradient(0deg, rgba(0,0,0,0.15) 0px, rgba(0,0,0,0.15) 1px, transparent 1px, transparent 4px); }
    .ninja-card { background: #000 !important; border: 4px solid #fff !important; border-radius: 0 !important; box-shadow: 5px 5px 0 #fff !important; color: #fff !important; }
    .ninja-item { color: #00ffff !important; border-bottom-color: rgba(255,255,255,0.15) !important; }
    h2 { color: #ffff00 !important; text-shadow: 2px 2px 0 #ff0000; }
    .text-muted { color: #888 !important; }
    .totem-grid::-webkit-scrollbar-thumb { border-color: #000 !important; }
  </style>
  <% } %>
</head>
<body>
  <% if (locals.user) { %>
    <div class="sidebar">
      <div class="p-4 text-center"><img src="/img/cn_logo.png" height="30" alt="Code Ninjas"></div>
      <div class="mt-4">
        <a href="/admin" class="nav-link d-block"><i class="bi bi-speedometer2 me-2"></i> Dashboard Home</a>
        <a href="/belts" class="nav-link d-block active"><i class="bi bi-trophy me-2"></i> Belts Totem</a>
        <a href="/logout" class="nav-link d-block mt-4 text-danger"><i class="bi bi-box-arrow-right me-2"></i> Logout</a>
      </div>
    </div>
  <% } %>



  <main class="main <%= locals.user ? 'with-sidebar' : 'no-sidebar' %>">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <% if (!locals.user) { %>
          <div class="d-flex gap-2 mb-3">
            <a href="/" class="btn btn-outline-secondary btn-sm btn-back"><i class="bi bi-arrow-left me-1"></i> Dashboard</a>
            <a href="/ninjabucks" class="btn btn-outline-primary btn-sm btn-back"><i class="bi bi-coin me-1"></i> Ninja Bucks</a>
          </div>
        <% } %>
        <h2 class="fw-bold mb-1">Belts Totem</h2>
        <% if (locals.user) { %>
          <p class="text-muted">Admin view.</p>
        <% } else { %>
          <p class="text-muted">Celebrating the achievements of our Ninjas!</p>
        <% } %>
      </div>
    </div>

    <div class="scroll-container-wrapper">
      <div class="scroll-btn" id="scrollRightBtn">
        <i class="bi bi-chevron-right"></i>
      </div>

      <div class="totem-grid" id="totemGrid">
        <% 
          const BELT_LIST = ['White', 'Yellow', 'Orange', 'Green', 'Blue', 'Purple', 'Brown', 'Red', 'Black', 'Bronze', 'Silver', 'Platinum', 'Gold', 'Going Gold'];
          BELT_LIST.forEach(beltName => { 
            const beltClass = 'belt-' + beltName.toLowerCase().replace(' ', '-');
            const borderClass = 'border-' + beltName.toLowerCase().replace(' ', '-');
            const beltNinjas = ninjas.filter(n => n.currentBelt === beltName);
        %>
          <div class="belt-column">
            <div class="belt-header <%= beltClass %>">
              <%= beltName %>
            </div>
            
            <div class="ninja-card <%= borderClass %>">
              <ul class="ninja-list">
                <% if (beltNinjas.length > 0) { %>
                  <% beltNinjas.forEach(ninja => { %>
                    <li class="ninja-item"><%= ninja.name %></li>
                  <% }) %>
                <% } else { %>
                  <li class="ninja-item text-muted small italic">Coming soon...</li>
                <% } %>
              </ul>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </main>

  <script src="/js/bootstrap.bundle.min.js"></script>
  <script>
    const grid = document.getElementById('totemGrid');
    const btn = document.getElementById('scrollRightBtn');
    
    btn.addEventListener('click', () => {
      const scrollAmount = 400; // Scroll by roughly 1.5 columns
      const maxScroll = grid.scrollWidth - grid.clientWidth;
      
      if (grid.scrollLeft >= maxScroll - 10) {
        // If at the end, jump back to start
        grid.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        grid.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      }
    });

    // Toggle button icon if at end
    grid.addEventListener('scroll', () => {
      const maxScroll = grid.scrollWidth - grid.clientWidth;
      const icon = btn.querySelector('i');
      if (grid.scrollLeft >= maxScroll - 10) {
        icon.classList.replace('bi-chevron-right', 'bi-arrow-left-circle-fill');
      } else {
        icon.classList.replace('bi-arrow-left-circle-fill', 'bi-chevron-right');
      }
    });
  </script>
</body>
</html>
